# EmailJS (https://dashboard.emailjs.com). These are public, browser-side values.
# Template params used by the contact form: from_name, email_id, message
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# Only for GitHub Pages without a custom domain, e.g. /portfolio
NEXT_PUBLIC_BASE_PATH=
